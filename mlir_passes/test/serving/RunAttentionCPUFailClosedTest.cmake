execute_process(COMMAND "${TOOL}" --device-profile "${PROFILE}" --mlir "${INPUT}" --out "${OUT}" --dump-annotated-mlir "${DUMP}" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "compile-for-target failed while preserving unsupported graphs: ${err}")
endif()
file(READ "${DUMP}" ir)
foreach(needle IN ITEMS "incomplete_qkv" "missing_softmax" "missing_causal" "unsupported_f16" "unsupported_gqa" "dynamic_head_dim")
  string(FIND "${ir}" "${needle}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "unsupported fallback graph disappeared: ${needle}")
  endif()
endforeach()
foreach(forbidden IN ITEMS "hir.attention" "hir.cpu_attention" "cpu_attention_prefill_fp32" "cpu_attention_decode_fp32")
  string(FIND "${ir}" "${forbidden}" pos)
  if(NOT pos EQUAL -1)
    message(FATAL_ERROR "unsupported graph was incorrectly rewritten: ${forbidden}")
  endif()
endforeach()
