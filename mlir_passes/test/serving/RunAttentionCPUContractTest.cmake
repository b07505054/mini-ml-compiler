execute_process(COMMAND "${TOOL}" --device-profile "${PROFILE}" --mlir "${INPUT}" --out "${OUT}" --dump-annotated-mlir "${DUMP}" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "compile-for-target failed: ${err}")
endif()
file(READ "${DUMP}" ir)
file(READ "${OUT}" plan)
foreach(needle IN ITEMS "hir.cpu_attention" "cpu_attention_prefill_fp32" "cpu_attention_decode_fp32" "hir_cpu_attention_prefill_fp32" "hir_cpu_attention_decode_fp32" "runtime_no_redecision = true")
  string(FIND "${ir}" "${needle}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "missing lowered IR evidence: ${needle}")
  endif()
endforeach()
foreach(needle IN ITEMS "attention_execution" "cpu_attention_prefill_fp32" "cpu_attention_decode_fp32" "bhsd_contiguous" "operator_level_fp32_cpu_attention")
  string(FIND "${plan}" "${needle}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "missing plan evidence: ${needle}")
  endif()
endforeach()
