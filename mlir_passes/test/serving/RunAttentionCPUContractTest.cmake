execute_process(COMMAND "${TOOL}" --device-profile "${PROFILE}" --mlir "${INPUT}" --out "${OUT}" --dump-annotated-mlir "${DUMP}" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "compile-for-target failed: ${err}")
endif()
file(READ "${DUMP}" ir)
file(READ "${OUT}" plan)
foreach(needle IN ITEMS "hir.cpu_attention" "hir.kv_cache_create" "hir.kv_cache_prefill_write" "hir.kv_cache_append" "hir.kv_cache_view" "cpu_attention_prefill_fp32" "cpu_attention_decode_fp32" "hir_cpu_attention_prefill_fp32" "hir_cpu_attention_decode_contiguous_kv_fp32" "dimension_major_strided_v_accumulation" "runtime_no_redecision = true")
  string(FIND "${ir}" "${needle}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "missing lowered IR evidence: ${needle}")
  endif()
endforeach()
foreach(needle IN ITEMS "attention_execution" "kv_cache_execution" "cpu_contiguous_kv_fp32_v1" "bytes_per_token" "total_cache_bytes" "append_then_view_then_decode_attention" "cpu_attention_prefill_fp32" "cpu_attention_decode_fp32" "bhsd_contiguous" "operator_level_fp32_cpu_attention")
  string(FIND "${plan}" "${needle}" pos)
  if(pos EQUAL -1)
    message(FATAL_ERROR "missing plan evidence: ${needle}")
  endif()
endforeach()

# Exercise the second real contiguous candidate through the normal
# compile-for-target path without replacing the historical default.
file(READ "${INPUT}" reordered_source)
string(REPLACE "attention.cpu.kv_capacity_tokens = 512 : i64," "attention.cpu.kv_capacity_tokens = 512 : i64, attention.cpu.contiguous_decode_strategy = \"token_major_contiguous_v_accumulation\"," reordered_source "${reordered_source}")
set(reordered_input "${OUT}.reordered.mlir")
set(reordered_out "${OUT}.reordered.json")
set(reordered_dump "${DUMP}.reordered.mlir")
file(WRITE "${reordered_input}" "${reordered_source}")
execute_process(COMMAND "${TOOL}" --device-profile "${PROFILE}" --mlir "${reordered_input}" --out "${reordered_out}" --dump-annotated-mlir "${reordered_dump}" RESULT_VARIABLE reordered_rc ERROR_VARIABLE reordered_err)
if(NOT reordered_rc EQUAL 0)
  message(FATAL_ERROR "reordered contiguous compile-for-target failed: ${reordered_err}")
endif()
file(READ "${reordered_out}" reordered_plan)
file(READ "${reordered_dump}" reordered_ir)
foreach(needle IN ITEMS "cpu_contiguous_kv_fp32_reordered_v1" "cpu_attention_decode_contiguous_kv_reordered_fp32" "hir_cpu_attention_decode_contiguous_kv_reordered_fp32" "token_major_contiguous_v_accumulation" "exact_target_workload_measured_evidence_required")
  string(FIND "${reordered_plan}" "${needle}" plan_pos)
  string(FIND "${reordered_ir}" "${needle}" ir_pos)
  if(plan_pos EQUAL -1 OR ir_pos EQUAL -1)
    message(FATAL_ERROR "missing reordered contiguous lowering/plan evidence: ${needle}")
  endif()
endforeach()
