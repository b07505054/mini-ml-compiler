body:             |
  bb.0 (%ir-block.21):
    successors: %bb.1(0x80000000)
    liveins: $x0, $x1, $x2, $x3, $x4, $x5, $x6, $x7
  
    %57:gpr64 = COPY $x1
    %70:gpr64 = LDRXui %fixed-stack.5, 0 :: (load (s64) from %fixed-stack.5)
    %77:gpr64 = LDRXui %fixed-stack.12, 0 :: (load (s64) from %fixed-stack.12, align 16)
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $sp, implicit $sp
    dead $w0 = MOVi32imm 1088, implicit-def $x0
    BL @malloc, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit $x0, implicit-def $sp, implicit-def $x0
    ADJCALLSTACKUP 0, 0, implicit-def dead $sp, implicit $sp
    %21:gpr64sp = COPY $x0
    %81:gpr64common = ADDXri %21, 63, 0
    %22:gpr64common = ANDXri %81, 7865
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $sp, implicit $sp
    dead $w0 = MOVi32imm 1088, implicit-def $x0
    BL @malloc, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit $x0, implicit-def $sp, implicit-def $x0
    ADJCALLSTACKUP 0, 0, implicit-def dead $sp, implicit $sp
    %28:gpr64sp = COPY $x0
    %87:gpr64common = ADDXri %28, 63, 0
    %29:gpr64common = ANDXri %87, 7865
    %102:fpr128 = MOVIv2d_ns 0
    %540:gpr64sp = COPY $xzr
    %541:gpr64common = COPY $xzr
  
  bb.1 (%ir-block.69):
    successors: %bb.2(0x7c000000), %bb.9(0x04000000)
  
    dead $xzr = SUBSXri %541, 15, 0, implicit-def $nzcv
    Bcc 12, %bb.9, implicit killed $nzcv
    B %bb.2
  
  bb.2..preheader:
    successors: %bb.3(0x80000000)
  
    %542:gpr64sp = COPY $xzr
    %543:gpr64common = COPY $xzr
  
  bb.3 (%ir-block.72):
    successors: %bb.4(0x7c000000), %bb.8(0x04000000)
  
    dead $xzr = SUBSXri %543, 15, 0, implicit-def $nzcv
    Bcc 12, %bb.8, implicit killed $nzcv
    B %bb.4
  
  bb.4 (%ir-block.75):
    successors: %bb.5(0x80000000)
  
    %97:gpr64 = ADDXrs %543, %541, 4
    %101:gpr64common = ADDXrs %22, %97, 2
    STRQui %102, %101, 1 :: (store (s128) into %ir.90 + 16, align 4)
    STRQui %102, %101, 0 :: (store (s128) into %ir.90, align 4)
    STRQui %102, %101, 5 :: (store (s128) into %ir.94 + 16, align 4)
    STRQui %102, %101, 4 :: (store (s128) into %ir.94, align 4)
    STRQui %102, %101, 9 :: (store (s128) into %ir.98 + 16, align 4)
    STRQui %102, %101, 8 :: (store (s128) into %ir.98, align 4)
    STRQui %102, %101, 13 :: (store (s128) into %ir.102 + 16, align 4)
    STRQui %102, %101, 12 :: (store (s128) into %ir.102, align 4)
    STRQui %102, %101, 17 :: (store (s128) into %ir.106 + 16, align 4)
    STRQui %102, %101, 16 :: (store (s128) into %ir.106, align 4)
    STRQui %102, %101, 21 :: (store (s128) into %ir.110 + 16, align 4)
    STRQui %102, %101, 20 :: (store (s128) into %ir.110, align 4)
    STRQui %102, %101, 25 :: (store (s128) into %ir.114 + 16, align 4)
    STRQui %102, %101, 24 :: (store (s128) into %ir.114, align 4)
    STRQui %102, %101, 29 :: (store (s128) into %ir.118 + 16, align 4)
    STRQui %102, %101, 28 :: (store (s128) into %ir.118, align 4)
    %544:gpr64common = COPY %540
