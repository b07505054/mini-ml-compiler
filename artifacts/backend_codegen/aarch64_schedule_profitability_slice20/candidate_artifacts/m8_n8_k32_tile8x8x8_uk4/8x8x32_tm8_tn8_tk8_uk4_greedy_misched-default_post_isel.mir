    %46:fpr128 = LDRQui %9, 14 :: (load (s128) from %ir.102, align 4)
    %47:fpr128 = MOVIv2d_ns 0
    %48:fpr128 = nofpexcept FMLAv4i32_indexed %47, %32, %16, 0, implicit $fpcr
    %49:fpr128 = nofpexcept FMLAv4i32_indexed %47, %31, %16, 0, implicit $fpcr
    %50:fpr128 = nofpexcept FMLAv4i32_indexed %47, %32, %18, 0, implicit $fpcr
