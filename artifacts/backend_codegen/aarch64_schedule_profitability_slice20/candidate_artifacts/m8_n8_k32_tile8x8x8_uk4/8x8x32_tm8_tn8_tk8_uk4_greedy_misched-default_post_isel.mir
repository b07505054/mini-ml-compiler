body:             |
  bb.0 (%ir-block.21):
    liveins: $x1
  
    %1:gpr64common = COPY $x1
    %8:gpr64common = LDRXui %fixed-stack.5, 0 :: (load (s64) from %fixed-stack.5)
    %9:gpr64common = LDRXui %fixed-stack.12, 0 :: (load (s64) from %fixed-stack.12, align 16)
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $sp, implicit $sp
    %10:gpr32 = MOVi32imm 320
    %11:gpr64all = SUBREG_TO_REG 0, killed %10, %subreg.sub_32
    $x0 = COPY %11
    BL @malloc, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit $x0, implicit-def $sp, implicit-def $x0
    ADJCALLSTACKUP 0, 0, implicit-def dead $sp, implicit $sp
    %12:gpr64sp = COPY $x0
    %13:gpr64common = ADDXri %12, 63, 0
    %14:gpr64sp = ANDXri killed %13, 7865
    %15:fpr128 = LDRQui %1, 1 :: (load (s128) from %ir.57 + 16, align 4)
    %16:fpr128 = LDRQui %1, 0 :: (load (s128) from %ir.57, align 4)
    %17:fpr128 = LDRQui %1, 9 :: (load (s128) from %ir.60 + 16, align 4)
    %18:fpr128 = LDRQui %1, 8 :: (load (s128) from %ir.60, align 4)
    %19:fpr128 = LDRQui %1, 17 :: (load (s128) from %ir.63 + 16, align 4)
    %20:fpr128 = LDRQui %1, 16 :: (load (s128) from %ir.63, align 4)
    %21:fpr128 = LDRQui %1, 25 :: (load (s128) from %ir.66 + 16, align 4)
    %22:fpr128 = LDRQui %1, 24 :: (load (s128) from %ir.66, align 4)
    %23:fpr128 = LDRQui %1, 33 :: (load (s128) from %ir.69 + 16, align 4)
    %24:fpr128 = LDRQui %1, 32 :: (load (s128) from %ir.69, align 4)
    %25:fpr128 = LDRQui %1, 41 :: (load (s128) from %ir.72 + 16, align 4)
    %26:fpr128 = LDRQui %1, 40 :: (load (s128) from %ir.72, align 4)
    %27:fpr128 = LDRQui %1, 49 :: (load (s128) from %ir.75 + 16, align 4)
    %28:fpr128 = LDRQui %1, 48 :: (load (s128) from %ir.75, align 4)
    %29:fpr128 = LDRQui %1, 57 :: (load (s128) from %ir.78 + 16, align 4)
    %30:fpr128 = LDRQui %1, 56 :: (load (s128) from %ir.78, align 4)
    %31:fpr128 = LDRQui %9, 0 :: (load (s128) from %ir.81, align 4)
    %32:fpr128 = LDRQui %9, 1 :: (load (s128) from %ir.81 + 16, align 4)
    %33:fpr128 = LDRQui %9, 3 :: (load (s128) from %ir.84 + 16, align 4)
    %34:fpr128 = LDRQui %9, 2 :: (load (s128) from %ir.84, align 4)
