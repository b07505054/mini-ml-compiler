    renamable $x9 = LDRXui renamable $x1, 2 :: (load (s64) from %ir.1 + 16)
    renamable $x10 = LDRXui renamable $x1, 1 :: (load (s64) from %ir.1 + 8)
    renamable $x0 = LDRXui killed renamable $x1, 0 :: (load (s64) from %ir.1)
    renamable $x7 = LDRXui renamable $x2, 0 :: (load (s64) from %ir.2)
    renamable $q0 = LDURQi renamable $x2, 8 :: (load (s128) from %ir.2 + 8, align 8)
    renamable $q1 = LDURQi renamable $x2, 24 :: (load (s128) from %ir.2 + 24, align 8)
    renamable $x11 = LDRXui renamable $x2, 5 :: (load (s64) from %ir.2 + 40)
    renamable $x12 = LDRXui killed renamable $x2, 6 :: (load (s64) from %ir.2 + 48)
    renamable $q2 = LDRQui renamable $x3, 0 :: (load (s128) from %ir.3, align 8)
    renamable $q3 = LDRQui renamable $x3, 1 :: (load (s128) from %ir.3 + 16, align 8)
    renamable $q4 = LDRQui renamable $x3, 2 :: (load (s128) from %ir.3 + 32, align 8)
    renamable $x13 = LDRXui killed renamable $x3, 6 :: (load (s64) from %ir.3 + 48)
    STRQui killed renamable $q4, $sp, 5 :: (store (s128), align 8)
    STRQui killed renamable $q3, $sp, 4 :: (store (s128), align 8)
    STRQui killed renamable $q2, $sp, 3 :: (store (s128), align 8)
    STRQui killed renamable $q1, $sp, 1 :: (store (s128), align 8)
    STRQui killed renamable $q0, $sp, 0 :: (store (s128), align 8)
    STRXui killed renamable $x13, $sp, 12 :: (store (s64) into stack + 96)
    STRXui killed renamable $x12, $sp, 5 :: (store (s64) into stack + 40)
    STRXui killed renamable $x11, $sp, 4 :: (store (s64) into stack + 32)
    $x1 = COPY killed renamable $x10
    $x2 = COPY killed renamable $x9
    $x3 = COPY killed renamable $x8
    BL @matmul_bias_relu_tiled_8x64x64, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit $x0, implicit $x1, implicit $x2, implicit $x3, implicit $x4, implicit $x5, implicit $x6, implicit $x7, implicit-def $sp, implicit-def $x0, implicit-def $x1, implicit-def $x2, implicit-def $x3, implicit-def $x4, implicit-def $x5, implicit-def $x6
    STRXui killed renamable $x0, renamable $x19, 0 :: (store (s64) into %ir.0)
    STRXui killed renamable $x1, renamable $x19, 1 :: (store (s64) into %ir.0 + 8)
    STRXui killed renamable $x2, renamable $x19, 2 :: (store (s64) into %ir.0 + 16)
    STRXui killed renamable $x3, renamable $x19, 3 :: (store (s64) into %ir.0 + 24)
    STRXui killed renamable $x4, renamable $x19, 4 :: (store (s64) into %ir.0 + 32)
    STRXui killed renamable $x5, renamable $x19, 5 :: (store (s64) into %ir.0 + 40)
    STRXui killed renamable $x6, killed renamable $x19, 6 :: (store (s64) into %ir.0 + 48)
    $lr, $x19 = frame-destroy LDPXi $sp, 14 :: (load (s64) from %stack.1), (load (s64) from %stack.0)
    $sp = frame-destroy ADDXri $sp, 128, 0
    RET_ReallyLR
