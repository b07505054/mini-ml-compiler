    renamable $x6 = LDRXui renamable $x1, 6 :: (load (s64) from %ir.1 + 48)
    renamable $x5 = LDRXui renamable $x1, 5 :: (load (s64) from %ir.1 + 40)
    renamable $x4 = LDRXui renamable $x1, 4 :: (load (s64) from %ir.1 + 32)
