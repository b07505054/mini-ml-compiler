  - { reg: '$x0', virtual-reg: '%0' }
  - { reg: '$x1', virtual-reg: '%1' }
  - { reg: '$x2', virtual-reg: '%2' }
  - { reg: '$x3', virtual-reg: '%3' }
frameInfo:
  isFrameAddressTaken: false
  isReturnAddressTaken: false
  hasStackMap:     false
  hasPatchPoint:   false
  stackSize:       0
  offsetAdjustment: 0
  maxAlignment:    8
  adjustsStack:    true
  hasCalls:        true
  stackProtector:  ''
  functionContext: ''
  maxCallFrameSize: 104
  cvBytesOfCalleeSavedRegisters: 0
  hasOpaqueSPAdjustment: false
  hasVAStart:      false
  hasMustTailInVarArgFunc: false
  hasTailCall:     false
  isCalleeSavedInfoValid: false
  localFrameSize:  0
  savePoint:       ''
  restorePoint:    ''
fixedStack:      []
stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0 (%ir-block.4):
    liveins: $x0, $x1, $x2, $x3
  
    %3:gpr64common = COPY $x3
    %2:gpr64common = COPY $x2
    %1:gpr64common = COPY $x1
    %0:gpr64common = COPY $x0
    %4:gpr64 = LDRXui %1, 6 :: (load (s64) from %ir.1 + 48)
    %5:gpr64 = LDRXui %1, 5 :: (load (s64) from %ir.1 + 40)
    %6:gpr64 = LDRXui %1, 4 :: (load (s64) from %ir.1 + 32)
    %7:gpr64 = LDRXui %1, 3 :: (load (s64) from %ir.1 + 24)
    %8:gpr64 = LDRXui %1, 2 :: (load (s64) from %ir.1 + 16)
    %9:gpr64 = LDRXui %1, 1 :: (load (s64) from %ir.1 + 8)
    %10:gpr64 = LDRXui %1, 0 :: (load (s64) from %ir.1)
    %11:gpr64 = LDRXui %2, 0 :: (load (s64) from %ir.2)
    %12:fpr128 = LDURQi %2, 8 :: (load (s128) from %ir.2 + 8, align 8)
    %13:fpr128 = LDURQi %2, 24 :: (load (s128) from %ir.2 + 24, align 8)
    %14:gpr64 = LDRXui %2, 5 :: (load (s64) from %ir.2 + 40)
    %15:gpr64 = LDRXui %2, 6 :: (load (s64) from %ir.2 + 48)
    %16:fpr128 = LDRQui %3, 0 :: (load (s128) from %ir.3, align 8)
    %17:fpr128 = LDRQui %3, 1 :: (load (s128) from %ir.3 + 16, align 8)
    %18:fpr128 = LDRQui %3, 2 :: (load (s128) from %ir.3 + 32, align 8)
    %19:gpr64 = LDRXui %3, 6 :: (load (s64) from %ir.3 + 48)
    ADJCALLSTACKDOWN 104, 0, implicit-def dead $sp, implicit $sp
    STRXui %19, $sp, 12 :: (store (s64) into stack + 96)
    STRQui %18, $sp, 5 :: (store (s128), align 8)
    STRQui %17, $sp, 4 :: (store (s128), align 8)
    STRQui %16, $sp, 3 :: (store (s128), align 8)
    STRXui %15, $sp, 5 :: (store (s64) into stack + 40)
    STRXui %14, $sp, 4 :: (store (s64) into stack + 32)
    STRQui %13, $sp, 1 :: (store (s128), align 8)
    STRQui %12, $sp, 0 :: (store (s128), align 8)
    $x0 = COPY %10
    $x1 = COPY %9
    $x2 = COPY %8
    $x3 = COPY %7
    $x4 = COPY %6
    $x5 = COPY %5
    $x6 = COPY %4
    $x7 = COPY %11
    BL @matmul_bias_relu_tiled_16x16x16, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit $x0, implicit $x1, implicit $x2, implicit $x3, implicit killed $x4, implicit killed $x5, implicit killed $x6, implicit killed $x7, implicit-def $sp, implicit-def $x0, implicit-def $x1, implicit-def $x2, implicit-def $x3, implicit-def $x4, implicit-def $x5, implicit-def $x6
    ADJCALLSTACKUP 104, 0, implicit-def dead $sp, implicit $sp
    %21:gpr64 = COPY $x0
    %22:gpr64 = COPY $x1
    %23:gpr64 = COPY $x2
    %24:gpr64 = COPY $x3
    %25:gpr64 = COPY killed $x4
    %26:gpr64 = COPY killed $x5
    %27:gpr64 = COPY killed $x6
    STRXui %21, %0, 0 :: (store (s64) into %ir.0)
    STRXui %22, %0, 1 :: (store (s64) into %ir.0 + 8)
    STRXui %23, %0, 2 :: (store (s64) into %ir.0 + 16)
    STRXui %24, %0, 3 :: (store (s64) into %ir.0 + 24)
    STRXui %25, %0, 4 :: (store (s64) into %ir.0 + 32)
    STRXui %26, %0, 5 :: (store (s64) into %ir.0 + 40)
    STRXui %27, %0, 6 :: (store (s64) into %ir.0 + 48)
    RET_ReallyLR
...
