stack:           []
entry_values:    []
callSites:       []
debugValueSubstitutions: []
constants:       []
machineFunctionInfo: {}
body:             |
  bb.0 (%ir-block.21):
    successors: %bb.1(0x80000000)
    liveins: $x0, $x1, $x2, $x3, $x4, $x5, $x6, $x7
  
    %37:gpr64 = COPY $x1
    %50:gpr64 = LDRXui %fixed-stack.5, 0 :: (load (s64) from %fixed-stack.5)
    %57:gpr64 = LDRXui %fixed-stack.12, 0 :: (load (s64) from %fixed-stack.12, align 16)
    ADJCALLSTACKDOWN 0, 0, implicit-def dead $sp, implicit $sp
    dead $w0 = MOVi32imm 1088, implicit-def $x0
    BL @malloc, csr_aarch64_aapcs, implicit-def dead $lr, implicit $sp, implicit $x0, implicit-def $sp, implicit-def $x0
    ADJCALLSTACKUP 0, 0, implicit-def dead $sp, implicit $sp
