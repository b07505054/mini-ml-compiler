{
  "methodology": {
    "llvm_ir_instructions": "lines in generated_<shape>.ll containing ' = ' or starting with store/br/ret/call, whole file",
    "aarch64_instructions": "llvm-objdump -d --no-show-raw-insn on the whole .o, address-prefixed lines, mnemonic field only",
    "static_fmla": "count of disassembled lines whose mnemonic is exactly 'fmla' -- the number of FMLA instructions PRESENT IN THE OBJECT TEXT, independent of how many times a loop executes them",
    "dynamic_fmla_per_invocation": "static_fmla for fully-unrolled variants (no loop, so static==dynamic); for tiled, computed as (M/4)*(N/8)*(K/8)*64 -- the K-loop's 64-FMLA body executed once per (M-tile, N-tile, K-tile) triple. Always equals M*N*K/4 for both variants, since both perform the same total arithmetic -- this is the static/dynamic distinction the tiled slice exists to demonstrate: identical dynamic work, drastically different static code size.",
    "loads_stores_branches": "mnemonic-exact match on {ldr,ldp,ldur,ld1} / {str,stp,stur,st1} / {b,bl,b.<cond>,cbz,cbnz}",
    "object_size_bytes": "stat size of the .o file",
    "text_bytes": "llvm-objdump -h .text section size field",
    "largest_vector_width": "max N in '<N x float>' LLVM IR vector types appearing in generated_<shape>.ll; 0 if none",
    "outer_loop_labels": "count of '.LBBn_m:' basic-block labels in the .s file -- a rough structural proxy for loop presence (generic's scalar loop-from-convert-linalg-to-loops also produces multiple labels; fully-unrolled has zero because vectorize_children_and_apply_patterns with no tiling produces straight-line code)"
  },
