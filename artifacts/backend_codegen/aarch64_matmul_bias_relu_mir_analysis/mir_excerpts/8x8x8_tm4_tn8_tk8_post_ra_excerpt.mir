    ADJCALLSTACKUP 0, 0, implicit-def dead $sp, implicit $sp
    renamable $x8 = COPY $xzr
    renamable $x9 = ADDXri renamable $x0, 63, 0
    renamable $x1 = ANDXri killed renamable $x9, 7865
    renamable $q0 = MOVIv2d_ns 0
  
  bb.1 (%ir-block.56):
    successors: %bb.2(0x7c000000), %bb.3(0x04000000)
    liveins: $q0, $x0, $x1, $x8, $x19, $x20, $x21
  
    dead $xzr = SUBSXri renamable $x8, 7, 0, implicit-def $nzcv
    Bcc 12, %bb.3, implicit killed $nzcv
    B %bb.2
  
