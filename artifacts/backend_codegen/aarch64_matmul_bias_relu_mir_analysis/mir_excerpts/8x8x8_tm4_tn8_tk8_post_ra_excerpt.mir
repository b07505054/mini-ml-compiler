    renamable $q21 = LDRQui renamable $x21, 2 :: (load (s128) from %ir.76, align 4)
    renamable $q16 = nofpexcept FMLAv4i32_indexed killed renamable $q16, renamable $q21, renamable $q22, 1, implicit $fpcr
